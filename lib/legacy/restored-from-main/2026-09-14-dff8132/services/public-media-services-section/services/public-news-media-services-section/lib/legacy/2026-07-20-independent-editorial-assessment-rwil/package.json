{
  "name": "@emsenn/independent-editorial-assessment",
  "version": "0.1.0",
  "type": "module",
  "description": "Separately hireable independent editorial assessment returning a validated bounded tool selection and prose grounds.",
  "bin": {
    "solicit-service": "./src/contract-editorial-assessment.mjs",
    "invoke-service": "./src/contract-editorial-assessment.mjs"
  },
  "scripts": {
    "check": "node --check src/law.mjs && node --check src/contract-editorial-assessment.mjs && node --check test/contract-editorial-assessment.test.mjs",
    "test": "node --test test/contract-editorial-assessment.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@emsenn/a2a-services-section": "file:../../../../../red-cup-engineering/services/web-services-section/services/a2a-services-section",
    "@emsenn/rmn-semantic-conformance": "file:../../../../../lenticule-science/services/obsmetrological-services-section/services/rmn-semantic-conformance",
    "@emsenn/rwil-rdf-services": "file:../../../../../lenticule-science/services/obsmetrological-services-section/services/rwil-rdf-services"
  },
  "x-agentic-metro-enterprise": {
    "node-id": "independent-editorial-assessment",
    "actor": "urn:ame:independent-editorial-assessment",
    "account": "eip155:31337:0x58154a71f5d78e492b3f177da2d52b81e32a875a",
    "membrane": { "law": "lib/", "lasting-instances": "content/", "append-only-instances": "data/" },
    "operation-catalog": {
      "solicit-service": {
        "contract": "ni:///sha-256;ewUzeckhgI2-phiqjqnnUrX1jog2n1bfPK0stTGJ_10",
        "accepts": "ActivityStreams Offer<ServiceSolicitation>",
        "returns": "ActivityStreams Offer<ExecutableServiceOffer>|Reject",
        "timeoutMs": 30000
      },
      "invoke-service": {
        "contract": "ni:///sha-256;ewUzeckhgI2-phiqjqnnUrX1jog2n1bfPK0stTGJ_10",
        "accepts": "ActivityStreams Accept<ServiceContract>",
        "returns": "ActivityStreams Accept<EditorialToolSelectionDelivery>|Reject",
        "timeoutMs": 1200000
      }
    }
  }
}
